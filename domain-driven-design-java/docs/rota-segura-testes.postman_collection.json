    {
      "name": "2. Login e token CSRF",
      "item": [
        {
          "name": "Login com senha errada: 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{user}}\",\n  \"password\": \"senha-errada-de-teste\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"user\") || !pm.variables.get(\"pass\")) {",
                  "    throw new Error(\"Defina as variáveis user e pass (environment ou --env-var). Não grave a senha na coleção.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"mensagem de login recusado\", () => pm.expect(pm.response.json().title).to.eql(\"Login não realizado\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{user}}\",\n  \"password\": \"{{pass}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"user\") || !pm.variables.get(\"pass\")) {",
                  "    throw new Error(\"Defina as variáveis user e pass (environment ou --env-var). Não grave a senha na coleção.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "csrf"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test(\"cabeçalho X-CSRF-TOKEN\", () => pm.expect(t.headerName).to.eql(\"X-CSRF-TOKEN\"));",
                  "pm.collectionVariables.set(\"csrf\", t.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Pessoas assistidas com login",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assisted-people",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assisted-people"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const people = pm.response.json();",
                  "pm.test(\"6 pessoas, todas com responsável (RN03)\", () => {",
                  "    pm.expect(people.length).to.be.at.least(6);",
                  "    people.forEach(p => pm.expect(p.guardians.length).to.be.above(0));",
                  "});",
                  "pm.collectionVariables.set(\"beneditaId\", people.find(p => p.name === \"Benedita Moraes Lima\").id);",
                  "pm.collectionVariables.set(\"antonioId\", people.find(p => p.name === \"Antônio Carvalho Nunes\").id);"
                ]
              }
            }
          ]
        }
      ]
