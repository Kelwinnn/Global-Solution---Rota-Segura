    {
      "name": "3. Rota até o abrigo (RF07)",
      "item": [
        {
          "name": "Benedita (Jardim Helena): rota encontrada",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assisted-people/{{beneditaId}}/route",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assisted-people",
                "{{beneditaId}}",
                "route"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const tries = Number(pm.collectionVariables.get(\"routeTries\") || 0);",
                  "if (body.status === \"ROUTE_UNAVAILABLE\" && \"ROUTE_FOUND\" !== \"ROUTE_UNAVAILABLE\" && tries < 3) {",
                  "    pm.collectionVariables.set(\"routeTries\", tries + 1);",
                  "    console.log(\"Serviço Python acordando; nova tentativa em 20 s (\" + (tries + 1) + \"/3)\");",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "    setTimeout(() => {}, 20000);",
                  "    return;",
                  "}",
                  "pm.collectionVariables.set(\"routeTries\", 0);",
                  "pm.test(\"status da rota = ROUTE_FOUND\", () => pm.expect(body.status).to.eql(\"ROUTE_FOUND\"));",
                  "pm.test(\"sempre traz uma orientação (message)\", () => pm.expect(body.message).to.be.a(\"string\").and.not.empty);",
                  "",
                  "pm.test(\"abrigo com endereço do cadastro\", () => {",
                  "    pm.expect(body.shelter).to.be.an(\"object\");",
                  "    pm.expect(body.shelter.address).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.test(\"distância, tempo e caminho\", () => {",
                  "    pm.expect(body.distanceMeters).to.be.above(0);",
                  "    pm.expect(body.durationMin).to.be.above(0);",
                  "    pm.expect(body.path.length).to.be.above(1);",
                  "});",
                  "console.log(\"Rota: \" + body.shelter.name + \" - \" + body.distanceMeters + \" m, \" + body.durationMin + \" min\");",
                  "",
                  "pm.collectionVariables.set(\"baseDistance\", body.distanceMeters);"
                ]
              }
            }
          ]
        },
        {
          "name": "Antônio (Poá): fora do bairro-piloto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assisted-people/{{antonioId}}/route",
              "host": [
                "{{baseUrl}}"
              ],
