    {
      "name": "3. Mapa de risco (RF04)",
      "item": [
        {
          "name": "Nível de risco de todas as áreas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const areas = pm.response.json();",
                  "const byName = Object.fromEntries(areas.map(a => [a.areaName, a]));",
                  "const expected = [{\"area\": \"Várzea do Jardim Helena\", \"level\": \"HIGH\", \"water\": 4.6, \"sensor\": \"SEN-JH-001\"}, {\"area\": \"Beira-Rio do Jardim Pantanal\", \"level\": \"VERY_HIGH\", \"water\": 5.8, \"sensor\": \"SEN-JP-001\"}, {\"area\": \"Baixada de São Miguel\", \"level\": \"LOW\", \"water\": 0.2, \"sensor\": \"SEN-SM-001\"}, {\"area\": \"Córrego do Itaim Paulista\", \"level\": \"MEDIUM\", \"water\": 1.5, \"sensor\": \"SEN-IP-001\"}, {\"area\": \"Baixada Leste de Guarulhos\", \"level\": \"VERY_URGENT\", \"water\": 11.3, \"sensor\": \"SEN-GRU-001\"}];",
                  "expected.forEach(e => pm.test(`${e.area}: ${e.level} (${e.water} cm, ${e.sensor})`, () => {",
                  "    const area = byName[e.area];",
                  "    pm.expect(area, 'área não encontrada: rode o dml.sql antes').to.exist;",
                  "    pm.expect(area.hasData).to.be.true;",
                  "    pm.expect(area.riskLevel).to.eql(e.level);",
                  "    pm.expect(area.waterLevelCm).to.eql(e.water);",
                  "    pm.expect(area.sensorCode).to.eql(e.sensor);",
                  "}));",
                  "pm.test('Áreas sem leitura recente aparecem com hasData false', () => {",
                  "    const withoutData = areas.filter(a => !a.hasData);",
                  "    withoutData.forEach(a => pm.expect(a.riskLevel).to.be.null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/areas/risk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "areas",
                "risk"
              ]
            },
            "description": "Em cada área vale a pior entre as leituras mais recentes (última 1 hora) dos sensores ativos."
          }
        },
        {
          "name": "Histórico do SEN-JH-001",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('A mais recente vem primeiro', () => pm.expect(pm.response.json()[0].waterLevelCm).to.eql(4.6));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/sensor-readings?sensorId={{sensorIdJH001}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sensor-readings"
              ],
              "query": [
                {
                  "key": "sensorId",
                  "value": "{{sensorIdJH001}}"
                }
              ]
            },
            "description": "Histórico do sensor (mais recentes primeiro). O id vem da resposta da primeira leitura."
          }
        }
      ]
    }
  ]
