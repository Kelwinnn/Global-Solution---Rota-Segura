{
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(mvn *)",
      "Bash(npm run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(docker *)"
    ],
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Edit(/data-science/**)",
      "Edit(/dynamic-programming/**)",
      "Edit(/ar-vr-modelling/**)",
      "Edit(/network-architect-solutions/**)",
      "Edit(/prompts.md)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_prompt.py\""
          }
        ]
      }
    ]
  }
}
